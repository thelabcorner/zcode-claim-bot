# --- ZCode auto-claim configuration ---
# Copy to .env and fill in. All values optional except TELEGRAM for alerts.

# Telegram notification target (your bot from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ZCode install location (default will be inferred on Windows)
ZCODE_EXE=C:\Users\<you>\AppData\Local\Programs\ZCode\ZCode.exe
# The renderer inspect port. Must be free or launch with --remote-debugging-port
ZCODE_CDP_PORT=9333
# If ZCode is not running, bot launches it with the debug flag itself.
# Set to "false" to only claim when ZCode already has the port open.
ZCODE_AUTO_LAUNCH=true

# Poll cadence (minutes)
POLL_IDLE_MINUTES=30
# Inside "hot" windows (Fri 00:00 + Beijing off-peak daily)
POLL_HOT_MINUTES=2
# Beijing weekdays: the surprise drops open 00:00 daily; waves around 22:00-08:00 (next-day refill)
HOT_WINDOWS_ASIA23=1

# Claim retry when server says 1005 "exceed quota limit" (packs replenish in waves)
CLAIM_RETRY_TIMES=12
CLAIM_RETRY_DELAY_SEC=20

# Optional: only claim these models, comma-separated, case-insensitive (e.g. "glm-5.3-flash,glm-5.3")
# Empty = claim anything.
CLAIM_MODEL_FILTER=
# Don't claim offers whose total entitlements are below this many tokens (e.g. "50000000") 
CLAIM_MIN_TOKENS=
